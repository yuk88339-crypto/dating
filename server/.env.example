# NearChat Server Environment Variables
PORT=3000
MAX_RADIUS_KM=30
CLIENT_ORIGIN="*"
IP_SALT="your_secure_random_salt_here"

# MongoDB connection string (optional - falls back to in-memory store if unset)
MONGO_URI="mongodb://localhost:27017/nearchat"

# WebRTC TURN server configuration (optional - public STUN is used by default)
TURN_SERVER=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
